    <!-- EXAMPLES  -->
    <command:examples>
      <command:example>
        <maml:title>-------------------------- EXAMPLE 1 --------------------------</maml:title>
        <maml:introduction>
          <maml:para>
          </maml:para>
        </maml:introduction>
        <dev:code>$Key = "SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce"</dev:code>
        <dev:remarks>
          <maml:para>
Set-RegString -Key $Key -Value Notepad -Data "notepad.exe"        

Description
-----------
The command Sets or Creates a registry value named Notepad on the local computer RunOnce key.
The name of ComputerName parameter, which is optional, is omitted.











</maml:para>
        </dev:remarks>
        <command:commandLines>
          <command:commandLine>
            <command:commandText>
            </command:commandText>
          </command:commandLine>
